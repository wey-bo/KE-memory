  "jcs_cases": [
    {
      "name": "ECMAScript number serialization",
      "value": {
        "one": 1.0,
        "negative_zero": -0.0,
        "tiny": 1e-7,
        "large": 1e20
      },
      "expected_canonical_text": "{\"large\":100000000000000000000,\"negative_zero\":0,\"one\":1,\"tiny\":1e-7}",
      "expected_sha256": "0371b25e0cd46044aec6f6f7753c0113375d28e500fae6284a59976f704c3f90"
    },
    {
      "name": "UTF-16 object key ordering",
      "value": {
        "\ue000": "bmp",
        "\ud800\udc00": "supplementary",
        "a": "ascii"
      },
      "expected_canonical_text": "{\"a\":\"ascii\",\"\ud800\udc00\":\"supplementary\",\"\ue000\":\"bmp\"}",
      "expected_sha256": "bb91dd129735878b55f54510de66db85f3fa2017aa6ef4b234e2a1587414d631"
    }
  ],
  "jcs_error_cases": [
    {
      "name": "NFC object key collision",
      "value": {
        "\u00e9": "precomposed",
        "e\u0301": "decomposed"
      },
      "expected_error": "NFC object key collision"
    }
  ]
}
